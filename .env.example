# SmartWorkingDays — Variabili d'ambiente
# Copia questo file in .env e compila i valori reali
# Il file .env NON va committato (è già in .gitignore)

# Token di autenticazione per il database Turso
VITE_TURSO_TOKEN=il_tuo...n
# URL del database Turso (opzionale — default in config.ts)
# VITE_TURSO_URL=https://tuo-db.turso.io

# Resend — invio email di reset password (https://resend.com)
# Piano gratuito: 100 email/giorno, zero restrizioni dominio
# VITE_RESEND_API_KEY=re_xxxxxxxxxxxx
# VITE_RESEND_FROM_EMAIL=EOS Smart Working <noreply@eosprod.com>
